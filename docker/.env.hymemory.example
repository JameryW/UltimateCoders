# hy-memory cognitive memory backend — docker/.env template.
#
# Copy to docker/.env (git-ignored) and fill in the two keys:
#   cp docker/.env.hymemory.example docker/.env
#
# Then:  docker compose -f docker/docker-compose.yml \
#         -f docker/docker-compose.hymemory.yml --profile app up --build
#        docker compose -f docker/docker-compose.yml \
#         -f docker/docker-compose.hymemory.yml --profile app run --rm \
#         --no-deps worker python -m ultimate_coders.agent.hy_memory --check
#
# Only the hy-memory-specific values are listed here; every other setting
# keeps the docker/.env.example default. See docs/hy-memory.md.

# ── hy-memory: cognitive memory backend ─────────────────────────────
# The SDK speaks the OpenAI protocol, so ANY OpenAI-compatible provider
# works. The DeepSeek example below is the recommended pairing: it doubles
# as the coding agent's provider under dsec.

# Extraction LLM (facts/experiences from agent traces). Required.
MEMORY_LLM_API_KEY=
# Recommended with DeepSeek; omit for the OpenAI default.
MEMORY_LLM_BASE_URL=https://api.deepseek.com
MEMORY_LLM_MODEL=deepseek-chat

# Embedding endpoint (vector writes/searches). Required; any
# OpenAI-compatible embedder (e.g. DashScope text-embedding-v3).
MEMORY_EMBEDDER_API_KEY=
MEMORY_EMBEDDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_EMBEDDER_MODEL=text-embedding-v3
MEMORY_EMBEDDING_DIMS=1024

# Operating mode: lite (raw embedding only) / pro (extraction + reconcile,
# default) / ultra (+ System 2, graph always on).
MEMORY_MODE=pro

# Local storage root for the SQLite metadata + Chroma vectors. The compose
# override mounts a named volume at /data/hy-memory, so memory survives
# container restarts without any extra setup.
MEMORY_DATA_DIR=/data/hy-memory

# Optional: relation graph in pro mode (off by default; ultra forces on).
# MEMORY_ENABLE_GRAPH=true

# ── MCP tool isolation coordinates (optional) ───────────────────────
# Scoping for the recall_coding_memory / remember_coding_memory MCP tools.
# Per-call overrides exist in the tool schemas; these are the defaults.
# UC_MEMORY_USER_ID=default
# UC_MEMORY_WORKSPACE=github.com/JameryW/UltimateCoders
# UC_MEMORY_BRANCH=main
