# UltimateCoders docker runtime config (copy to docker/.env, git-ignored).
#
# docker compose loads .env from the project directory = the parent of the
# first -f compose file. run-gateway.sh / run-cluster.sh use
# -f docker/docker-compose.yml, so the project dir is docker/ — put this
# at docker/.env. (A repo-root .env is NOT loaded.)
# All values are OPTIONAL — with an empty file the stack runs with graceful
# fallbacks (LLM decomposition degrades to newline-split, embeddings to
# exact-text matching).

# Host workspace path the gateway indexes (uc.repos.yaml scan_dirs).
# Same path in/out of the container — no remapping.
#   Mac:     /Users/<you>/aiworks
#   Linux:   /home/<you>/aiworks
#   Windows: WSL2 path (e.g. /home/<you>/aiworks), not a C:\ path
#
# Required if docker-compose.override.yml exists (it uses :? and errors on
# empty). To run WITHOUT local indexing, delete the override file and leave
# this unset — the gateway then serves external-git repos only.
UC_WORKSPACE_HOST=

# Override the uc.repos.yaml location only if your config lives inside the
# mounted workspace (otherwise the compose-root copy is used).
# UC_REPOS_CONFIG=

# ── Worker coding-agent LLM credentials ─────────────────────────────
# Coding agents are plugin-registry driven. UC_CODING_AGENT accepts any
# registered agent:
#   grok-build       — xAI Grok Build CLI (needs grok on PATH + XAI_API_KEY)
#   claude-code      — Anthropic Claude Code CLI (needs claude + key)
#   codex            — OpenAI Codex CLI (needs codex + key)
#   deepseek-harness — official DeepSeek Harness CLI (`dsh`, preinstalled
#                      in the worker image; needs DEEPSEEK_API_KEY)
# External plugins: install a package exposing the
# ultimate_coders.agent_adapters entry point, or set UC_AGENT_PLUGINS to
# .py files / package dirs (':'-separated). See
# python/ultimate_coders/agent/registry.py docstring.
# UC_CODING_AGENT=grok-build
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ── Local LLM server (Ollama / vLLM / LM Studio) ────────────────────
# Route BOTH the coding agent (Codex CLI custom provider) and the task
# decomposition (litellm) at a local OpenAI-compatible server. Codex
# requires the Responses API — Ollama >= 0.12 serves /v1/responses. Model
# names come from the server's model list (e.g. `ollama list`).
# UC_CODING_AGENT=codex
# UC_CODEX_OPENROUTER=true
# UC_OPENROUTER_MODEL=<local model name>
# UC_CODEX_OPENROUTER_BASE_URL=http://host.docker.internal:11434/v1
# UC_CODEX_OPENROUTER_WIRE_API=responses
# OPENROUTER_API_KEY=ollama-local        # dummy; Codex still prints this var
# UC_LLM_PROVIDER=openai
# OPENAI_API_BASE=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama-local
# OPENAI_DEFAULT_MODEL=openai/<local model name>
# ── OpenRouter cloud through the Codex CLI (explicit opt-in) ────────
# The provider profile is generated inside the worker container; the key
# stays only in docker/.env.
# UC_CODING_AGENT=codex
# UC_CODEX_OPENROUTER=true
# UC_OPENROUTER_MODEL=stealth/ox-alpha
# `stealth/ox-alpha` requires reasoning and rejects Codex's native web_search tool.
# UC_CODEX_WEB_SEARCH=disabled
# UC_OPENROUTER_REASONING_EFFORT=low
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Optional DeepSeek endpoint override for proxy gateways (read by dsh).
# DEEPSEEK_BASE_URL=
# UC_AGENT_PLUGINS=

# ── Semantic embeddings (gateway hybrid search + memory) ────────────
# Without a Voyage key the BLAKE3 fallback makes semantic memory search
# exact-text-only. Get a key at https://dash.voyageai.com
UC_VOYAGE_API_KEY=

# ── Gateway durable backends (opt-in) ───────────────────────────────
# The full-stack compose (docker-compose.yml) already enables all three.
# These matter for the STANDALONE gateway (run-gateway.sh up /
# docker-compose.gateway.yml), which defaults to `memory` for each and
# degrades gracefully (warn + in-memory) when a backend is selected but
# unreachable — enabling never blocks gateway startup.
# UC_EVENT_BACKEND=memory      # `nats` → NATS JetStream, needs UC_NATS_URL
# UC_TASK_BACKEND=memory       # `postgres` → tasks survive restarts
# UC_SCHEDULE_BACKEND=memory   # `postgres` → scheduled jobs survive restarts
# UC_DATABASE_URL=             # shared by both postgres backends

# ── External git sync (worker) ──────────────────────────────────────
# Empty UC_REPO_URL = local-only workspace (legacy mode).
# UC_REPO_URL=
# UC_REPO_BASE_BRANCH=main
# UC_GIT_FETCH_ON_ACQUIRE=true
# UC_GIT_PUSH_ON_RELEASE=false
# UC_GIT_TOKEN=
# GIT_USERNAME=x-access-token
