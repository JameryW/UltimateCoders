# Incremental OMP runtime layer. Compose supplies the freshly built worker
# image as the base_image build context, so a clean checkout needs no local
# image tag or manual build ordering. This layer adds Bun, the OMP workspace,
# and the UC extension.
FROM base_image

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl unzip \
    && rm -rf /var/lib/apt/lists/*

ENV BUN_INSTALL=/opt/bun \
    PATH=/opt/bun/bin:/root/.local/bin:/root/.grok/bin:${PATH}

RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.14" \
    && bun --version
COPY vendor/oh-my-pi /opt/oh-my-pi
# The extension keeps repo-relative paths to the vendored OMP sources in its
# tsconfig.  Preserve that path after relocating the repository into the
# image, so type declarations such as types/assets remain discoverable.
RUN mkdir -p /opt/vendor \
    && ln -s /opt/oh-my-pi /opt/vendor/oh-my-pi

# Refresh the dashboard source from the current checkout. The base image keeps
# the compiled engine/runtime, while this layer carries Python dashboard fixes
# without requiring a full Rust rebuild.
COPY python/ultimate_coders /app/python/ultimate_coders

RUN cd /opt/oh-my-pi \
    && sed -i 's/minimumReleaseAge = 259200/minimumReleaseAge = 0/' bunfig.toml \
    && bun install --registry=https://registry.npmjs.org --no-save --ignore-scripts --verbose
RUN cd /opt/oh-my-pi \
    && bun add --registry=https://registry.npmjs.org --no-save --ignore-scripts --verbose @oh-my-pi/pi-natives-linux-x64@16.1.16
COPY packages/uc-orchestrator /opt/oh-my-pi/uc-orchestrator
# The extension is copied after the OMP workspace install, so its own direct
# dependencies would otherwise be absent from the runtime image.  Install
# them here while keeping the vendored OMP packages as peer dependencies.
RUN cd /opt/oh-my-pi/uc-orchestrator \
    && /opt/bun/bin/bun install --registry=https://registry.npmjs.org --no-save --ignore-scripts --omit=peer --verbose \
    && test -f node_modules/nats/package.json \
    && test -f node_modules/@connectrpc/connect/package.json
RUN cd /opt/oh-my-pi \
    && bun --cwd=packages/collab-web run build:tool-views
RUN cd /opt/oh-my-pi \
    && bun --cwd=packages/coding-agent run generate-docs-index
# Keep the image contract explicit: the copied extension must remain
# executable by Bun after all OMP build steps have completed.
RUN test -f /opt/oh-my-pi/uc-orchestrator/node_modules/nats/package.json \
    && test -f /opt/oh-my-pi/uc-orchestrator/node_modules/@connectrpc/connect/package.json

COPY docker/omp-entrypoint.sh /usr/local/bin/uc-omp.sh
# Docker Desktop on Windows can present a CRLF working copy even when Git
# tracks this script as LF. Normalize before executing it so the shebang stays
# /bin/sh rather than the invalid /bin/sh\r.
RUN sed -i 's/\r$//' /usr/local/bin/uc-omp.sh \
    && chmod +x /usr/local/bin/uc-omp.sh

ENV UC_OMP_WORKSPACE=/workspace/UltimateCoders
